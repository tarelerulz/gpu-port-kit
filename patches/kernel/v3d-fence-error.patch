+static void
+v3d_job_record_dep(struct v3d_job *job, struct drm_file *file_priv, u32 handle)
+{
+	struct dma_fence *fence = NULL;
+
+	if (!job->dep_fences || job->dep_count >= job->dep_max)
+		return;
+	if (drm_syncobj_find_fence(file_priv, handle, 0, 0, &fence) == 0 && fence)
+		job->dep_fences[job->dep_count++] = fence;
+}
