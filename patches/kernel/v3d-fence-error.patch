+/* Non-zero (a negative errno) if a job this one depends on failed. */
+static int v3d_dep_error(struct v3d_job *job)
+{
+	u32 i;
+
+	for (i = 0; i < job->dep_count; i++) {
+		int st = dma_fence_get_status(job->dep_fences[i]);
+
+		if (st < 0) {
+			return st;
+		}
+	}
+	return 0;
+}
