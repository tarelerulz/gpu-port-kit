#version 450
// LayerNorm on k-major data (2026-11-12): x[c][t], rows of pitch TP (frames contiguous). One invocation per frame,
// so neighbouring threads read neighbouring addresses. y = (x - mean) / sqrt(var + 1e-5) * g[c] + b[c]. In place is fine.
// u: 0 T, 1 d, 2 TP, 3 in, 4 out, 5 gamma (weights), 6 beta (weights)
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(push_constant) uniform P { uint u[32]; } p;
void main() {
    uint t = gl_GlobalInvocationID.x;
    uint T = p.u[0], d = p.u[1], TP = p.u[2], inO = p.u[3] + t, outO = p.u[4] + t, gO = p.u[5], bO = p.u[6];
    if (t >= T) return;
    float mean = 0.0;
    for (uint c = 0u; c < d; c++) mean += a[inO + c * TP];
    mean /= float(d);
    float var = 0.0;
    for (uint c = 0u; c < d; c++) { float v = a[inO + c * TP] - mean; var += v * v; }
    var /= float(d);
    float inv = 1.0 / sqrt(var + 1e-5);
    for (uint c = 0u; c < d; c++)
        a[outO + c * TP] = (a[inO + c * TP] - mean) * inv * w[gO + c] + w[bO + c];
}
