#version 450
// GLU on k-major data (2026-11-12): in = 2d rows of pitch TP; out[i] = in[i] * sigmoid(in[n + i]) for i < n = d * TP.
// u: 0 n, 1 in, 2 out
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(push_constant) uniform P { uint u[32]; } p;
void main() {
    uint i = gl_GlobalInvocationID.x, n = p.u[0];
    if (i >= n) return;
    a[p.u[2] + i] = a[p.u[1] + i] / (1.0 + exp(-a[p.u[1] + n + i]));
}
