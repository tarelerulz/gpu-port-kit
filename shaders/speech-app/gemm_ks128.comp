#version 450
// small-M matmul with K split across the workgroup: workgroup = (output group cg = WG.x, frame group q = WG.y),
// 64 threads share the K loop, partial sums (12 outputs x 4 frames) reduced in shared memory.
// Same push layout as gemm12: u0 M, u1 N, u2 K, u3 NP, u4 Ab, u5 sAm, u6 sAk, u7 wo, u8 bo, u9 ob, u10 sOm, u11 sOn, u12 epi.
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 0) buffer A4 { vec4 a4[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(std430, binding = 1) readonly buffer W4 { vec4 w4[]; };
layout(push_constant) uniform P { uint u[32]; } p;
shared vec4 red[128][12];
float epi(float v, uint op) {
    if (op == 2u) return v / (1.0 + exp(-v));
    if (op == 3u) return max(v, 0.0);
    return v;
}
void main() {
    uint M = p.u[0], N = p.u[1], K = p.u[2], NP = p.u[3], Ab = p.u[4], sAm = p.u[5], sAk = p.u[6];
    uint wo = p.u[7], bo = p.u[8], ob = p.u[9], sOm = p.u[10], sOn = p.u[11], epiOp = p.u[12];
    uint cg = gl_WorkGroupID.x, q = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
    uint m0 = q * 4u;
    if (cg * 12u >= NP || m0 >= M) return;
    uint ws = NP / 4u;
    uint am0 = Ab + min(m0, M - 1u) * sAm, am1 = Ab + min(m0 + 1u, M - 1u) * sAm;
    uint am2 = Ab + min(m0 + 2u, M - 1u) * sAm, am3 = Ab + min(m0 + 3u, M - 1u) * sAm;
    vec4 acc[12];
    for (uint j = 0u; j < 12u; j++) acc[j] = vec4(0.0);
    for (uint k = t; k < K; k += 128u) {
        vec4 x = vec4(a[am0 + k * sAk], a[am1 + k * sAk], a[am2 + k * sAk], a[am3 + k * sAk]);
        vec4 w0 = w4[wo / 4u + k * ws + cg * 3u], w1 = w4[wo / 4u + k * ws + cg * 3u + 1u], w2 = w4[wo / 4u + k * ws + cg * 3u + 2u];
        acc[0] += w0.x * x; acc[1] += w0.y * x; acc[2] += w0.z * x; acc[3] += w0.w * x;
        acc[4] += w1.x * x; acc[5] += w1.y * x; acc[6] += w1.z * x; acc[7] += w1.w * x;
        acc[8] += w2.x * x; acc[9] += w2.y * x; acc[10] += w2.z * x; acc[11] += w2.w * x;
    }
    for (uint j = 0u; j < 12u; j++) red[t][j] = acc[j];
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1) {
        if (t < s) for (uint j = 0u; j < 12u; j++) red[t][j] += red[t + s][j];
        barrier();
    }
    if (t == 0u) {
        vec4 bv = (bo == 0xffffffffu) ? vec4(0.0) : w4[bo / 4u + cg * 3u];
        vec4 bv2 = (bo == 0xffffffffu) ? vec4(0.0) : w4[bo / 4u + cg * 3u + 1u];
        vec4 bv3 = (bo == 0xffffffffu) ? vec4(0.0) : w4[bo / 4u + cg * 3u + 2u];
        vec4 bb[3] = vec4[3](bv, bv2, bv3);
        for (uint j = 0u; j < 12u; j++) {
            uint nn = cg * 12u + j;
            if (nn >= N) continue;
            vec4 r = red[0][j] + bb[j / 4u][j % 4u];
            for (uint c = 0u; c < 4u; c++) {
                if (m0 + c >= M) continue;
                a[ob + (m0 + c) * sOm + nn * sOn] = epi(r[c], epiOp);
            }
        }
    }
}
