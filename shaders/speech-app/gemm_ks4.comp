#version 450
// timing variant: 4 accumulators per thread (one vec4 of weights per k: outputs cg*12 + 0..3)
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer W4 { vec4 w4[]; };
layout(push_constant) uniform P { uint u[32]; } p;
shared vec4 red[64][4];
void main() {
    uint M = p.u[0], N = p.u[1], K = p.u[2];
    uint Ab = p.u[4], sAm = p.u[5], wo2 = p.u[7], ob = p.u[9], sOm = p.u[10];
    uint cg = gl_WorkGroupID.x, q = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
    uint m0 = q * 4u;
    if (cg * 12u >= N || m0 >= M) return;
    uint w4base = wo2 / 4u + cg * 3u * K;
    uint am0 = Ab + min(m0, M - 1u) * sAm, am1 = Ab + min(m0 + 1u, M - 1u) * sAm;
    uint am2 = Ab + min(m0 + 2u, M - 1u) * sAm, am3 = Ab + min(m0 + 3u, M - 1u) * sAm;
    vec4 acc0 = vec4(0.0), acc1 = acc0, acc2 = acc0, acc3 = acc0;
    for (uint k = t; k < K; k += 64u) {
        vec4 x = vec4(a[am0 + k], a[am1 + k], a[am2 + k], a[am3 + k]);
        vec4 w0 = w4[w4base + k];
        acc0 += w0.x * x; acc1 += w0.y * x; acc2 += w0.z * x; acc3 += w0.w * x;
    }
    red[t][0] = acc0; red[t][1] = acc1; red[t][2] = acc2; red[t][3] = acc3;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (t < s) for (uint j = 0u; j < 4u; j++) red[t][j] += red[t + s][j];
        barrier();
    }
    if (t == 0u) {
        for (uint j = 0u; j < 4u; j++) {
            uint nn = cg * 12u + j;
            if (nn >= N) continue;
            for (uint c = 0u; c < 4u; c++) if (m0 + c < M) a[ob + (m0 + c) * sOm + nn] = red[0][j][c];
        }
    }
}
