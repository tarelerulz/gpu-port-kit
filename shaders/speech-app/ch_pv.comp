#version 450
// out[r][h*dh + e] = sum_k S[h][r][k] * V[k][h*dh + e]; one invocation per (h, r, vec4 chunk of e)
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 0) buffer A4 { vec4 a4[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(push_constant) uniform P { uint u[32]; } p;
void main() {
    uint id = gl_GlobalInvocationID.x;
    uint n = p.u[0], NK = p.u[1], H = p.u[2], dh = p.u[3], d = p.u[4];
    uint VO = p.u[5], SO = p.u[8], outO = p.u[9];
    uint nv = dh / 4u;
    uint total = H * n * nv;
    if (id >= total) return;
    uint v = id % nv, rem = id / nv, hh = rem / n, r = rem % n;
    uint sb = SO + (hh * n + r) * NK;
    vec4 acc = vec4(0.0);
    for (uint k = 0u; k < NK; k++) acc += a[sb + k] * a4[(VO + k * d + hh * dh) / 4u + v];
    a4[(outO + r * d + hh * dh) / 4u + v] = acc;
}
