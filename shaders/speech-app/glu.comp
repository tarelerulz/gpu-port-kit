#version 450
// GLU: y[t][c] = a * sigmoid(b), a = in[t][c], b = in[t][d + c]; in rows are 2d wide.
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(push_constant) uniform P { uint u[32]; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint T = p.u[0], d = p.u[1], inO = p.u[2], outO = p.u[3];
    if (i >= T * d) return;
    uint t = i / d, c = i % d;
    float av = a[inO + t * 2u * d + c], bv = a[inO + t * 2u * d + d + c];
    a[outO + i] = av / (1.0 + exp(-bv));
}
