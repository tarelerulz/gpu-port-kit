#version 450
// small-M matmul: 4 outputs x 4 frames per workgroup, K split over 64 threads.
// No variable-index arrays: 4 shared vec4 arrays and an unrolled epilogue (variable array indexing was the slow part).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer W4 { vec4 w4[]; };
layout(push_constant) uniform P { uint u[32]; } p;
shared vec4 r0[64]; shared vec4 r1[64]; shared vec4 r2[64]; shared vec4 r3[64];
float act(float v, uint op) {
    if (op == 2u) return v / (1.0 + exp(-v));
    if (op == 3u) return max(v, 0.0);
    return v;
}
void main() {
    uint M = p.u[0], N = p.u[1], K = p.u[2];
    uint Ab = p.u[4], sAm = p.u[5], wo4 = p.u[7], bo = p.u[8], ob = p.u[9], sOm = p.u[10], epiOp = p.u[12];
    uint cg = gl_WorkGroupID.x, q = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
    uint m0 = q * 4u;
    if (cg * 4u >= N || m0 >= M) return;
    uint wb = wo4 / 4u + cg * K;
    uint am0 = Ab + min(m0, M - 1u) * sAm, am1 = Ab + min(m0 + 1u, M - 1u) * sAm;
    uint am2 = Ab + min(m0 + 2u, M - 1u) * sAm, am3 = Ab + min(m0 + 3u, M - 1u) * sAm;
    vec4 acc0 = vec4(0.0), acc1 = acc0, acc2 = acc0, acc3 = acc0;
    for (uint k = t; k < K; k += 64u) {
        vec4 x = vec4(a[am0 + k], a[am1 + k], a[am2 + k], a[am3 + k]);
        vec4 w = w4[wb + k];
        acc0 += w.x * x; acc1 += w.y * x; acc2 += w.z * x; acc3 += w.w * x;
    }
    r0[t] = acc0; r1[t] = acc1; r2[t] = acc2; r3[t] = acc3;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (t < s) { r0[t] += r0[t + s]; r1[t] += r1[t + s]; r2[t] += r2[t + s]; r3[t] += r3[t + s]; }
        barrier();
    }
    if (t == 0u) {
        vec4 s0 = r0[0], s1 = r1[0], s2 = r2[0], s3 = r3[0];
        uint nn0 = cg * 4u, nn1 = nn0 + 1u, nn2 = nn0 + 2u, nn3 = nn0 + 3u;
        float b0 = (bo == 0xffffffffu) ? 0.0 : w4[(bo + nn0) / 4u][(bo + nn0) % 4u];
        float b1 = (bo == 0xffffffffu) ? 0.0 : w4[(bo + nn1) / 4u][(bo + nn1) % 4u];
        float b2 = (bo == 0xffffffffu) ? 0.0 : w4[(bo + nn2) / 4u][(bo + nn2) % 4u];
        float b3 = (bo == 0xffffffffu) ? 0.0 : w4[(bo + nn3) / 4u][(bo + nn3) % 4u];
        for (uint c = 0u; c < 4u; c++) {
            if (m0 + c >= M) continue;
            uint row = ob + (m0 + c) * sOm;
            if (nn0 < N) a[row + nn0] = act(s0[c] + b0, epiOp);
            if (nn1 < N) a[row + nn1] = act(s1[c] + b1, epiOp);
            if (nn2 < N) a[row + nn2] = act(s2[c] + b2, epiOp);
            if (nn3 < N) a[row + nn3] = act(s3[c] + b3, epiOp);
        }
    }
}
