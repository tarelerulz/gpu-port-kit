#version 450
// small-M matmul, 4 outputs x 4 frames per workgroup-tile, K split across 64 threads, 4 accumulators per thread.
// weights in [cg4][k] vec4 layout (wo4). Bias padded to NP (float offset bo).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer W4 { vec4 w4[]; };
layout(push_constant) uniform P { uint u[32]; } p;
shared vec4 red[64][4];
float epi(float v, uint op) {
    if (op == 2u) return v / (1.0 + exp(-v));
    if (op == 3u) return max(v, 0.0);
    return v;
}
void main() {
    uint M = p.u[0], N = p.u[1], K = p.u[2];
    uint Ab = p.u[4], sAm = p.u[5], wo4 = p.u[7], bo = p.u[8], ob = p.u[9], sOm = p.u[10], epiOp = p.u[12];
    uint cg = gl_WorkGroupID.x, q = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
    uint m0 = q * 4u;
    if (cg * 4u >= N || m0 >= M) return;
    uint wb = wo4 / 4u + cg * K;
    uint am0 = Ab + min(m0, M - 1u) * sAm, am1 = Ab + min(m0 + 1u, M - 1u) * sAm;
    uint am2 = Ab + min(m0 + 2u, M - 1u) * sAm, am3 = Ab + min(m0 + 3u, M - 1u) * sAm;
    vec4 acc0 = vec4(0.0), acc1 = acc0, acc2 = acc0, acc3 = acc0;
    for (uint k = t; k < K; k += 64u) {
        vec4 x = vec4(a[am0 + k], a[am1 + k], a[am2 + k], a[am3 + k]);
        vec4 w = w4[wb + k];
        acc0 += w.x * x; acc1 += w.y * x; acc2 += w.z * x; acc3 += w.w * x;
    }
    if (acc0.x + acc1.y + acc2.z + acc3.w == 123.456) a[ob] = 1.0;
}
