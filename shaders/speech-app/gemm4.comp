#version 450
// y[m][n] = epi(bias[n] + sum_k x[m][k] * W[k][n]); 4 outputs (n) x 4 frames (m) per thread.
// W stored [K][NP] (NP multiple of 4, padded), bias padded to NP. Output scalar stores.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 0) buffer A4 { vec4 a4[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(std430, binding = 1) readonly buffer W4 { vec4 w4[]; };
layout(push_constant) uniform P { uint u[32]; } p;
float act(float v, uint op) {
    if (op == 2u) return v / (1.0 + exp(-v));
    if (op == 3u) return max(v, 0.0);
    return v;
}
void main() {
    uint M = p.u[0], N = p.u[1], K = p.u[2], NP = p.u[3];
    uint Ab = p.u[4], sAm = p.u[5], sAk = p.u[6], wo = p.u[7], bo = p.u[8], ob = p.u[9], sOm = p.u[10];
    uint epi = p.u[12];
    uint q4 = (M + 3u) / 4u, i = gl_GlobalInvocationID.x;
    uint cg = i / q4, q = i % q4;
    if (cg * 4u >= NP) return;
    uint m0 = q * 4u;
    uint ws = NP / 4u;
    vec4 s0 = vec4(0.0), s1 = s0, s2 = s0, s3 = s0;
    uint am0 = Ab + min(m0, M - 1u) * sAm, am1 = Ab + min(m0 + 1u, M - 1u) * sAm;
    uint am2 = Ab + min(m0 + 2u, M - 1u) * sAm, am3 = Ab + min(m0 + 3u, M - 1u) * sAm;
    for (uint k = 0u; k < K; k++) {
        vec4 x = vec4(a[am0 + k * sAk], a[am1 + k * sAk], a[am2 + k * sAk], a[am3 + k * sAk]);
        vec4 wv = w4[wo / 4u + k * ws + cg];
        s0 += wv.x * x; s1 += wv.y * x; s2 += wv.z * x; s3 += wv.w * x;
    }
    vec4 bv = (bo == 0xffffffffu) ? vec4(0.0) : w4[bo / 4u + cg];
    vec4 acc[4];
    acc[0] = s0 + bv.x; acc[1] = s1 + bv.y; acc[2] = s2 + bv.z; acc[3] = s3 + bv.w;
    for (uint j = 0u; j < 4u; j++) {
        uint n = cg * 4u + j;
        if (n >= N) continue;
        for (uint c = 0u; c < 4u; c++) {
            if (m0 + c >= M) continue;
            a[ob + (m0 + c) * sOm + n] = act(acc[j][c], epi);
        }
    }
}
