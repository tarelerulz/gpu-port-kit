#version 450
// copy count floats: a[dst + i] = a[src + i]  (ranges must not overlap in a harmful way; dst < src here)
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(push_constant) uniform P { uint u[32]; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.u[0]) return;
    a[p.u[2] + i] = a[p.u[1] + i];
}
