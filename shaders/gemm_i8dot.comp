#version 450
#extension GL_EXT_integer_dot_product : require
// int8 matmul with packed 4-way dot products. Same tile as gemm12: 12 outputs x 4 rows per thread.
// A is packed along K: Ap[m][kq] holds A[m][4kq..4kq+3] as four int8 in one uint. W is packed Wp[kq][n] the same way.
// Output: int32 sums written as bits into the buffer (host reads them as int32). K % 4 == 0.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer A { uint au[]; };
layout(std430, binding = 1) readonly buffer W { uint wu[]; };
layout(push_constant) uniform P { uint u[32]; } p;
void main() {
    uint M = p.u[0], N = p.u[1], KQ = p.u[2], NP = p.u[3];   /* KQ = K/4 */
    uint Ab = p.u[4], Wo = p.u[7], ob = p.u[9], sOm = p.u[10];
    uint RG = (M + 3u) / 4u;
    uint idx = gl_GlobalInvocationID.x;
    uint cg = idx / RG, rg = idx % RG;
    if (cg * 12u >= NP) return;
    uint m0 = rg * 4u;
    uint r0 = Ab + min(m0, M - 1u) * KQ, r1 = Ab + min(m0 + 1u, M - 1u) * KQ;
    uint r2 = Ab + min(m0 + 2u, M - 1u) * KQ, r3 = Ab + min(m0 + 3u, M - 1u) * KQ;
    int acc0[12], acc1[12], acc2[12], acc3[12];
    for (uint j = 0u; j < 12u; j++) { acc0[j] = 0; acc1[j] = 0; acc2[j] = 0; acc3[j] = 0; }
    uint wb = Wo + cg * 12u;
    for (uint q = 0u; q < KQ; q++) {
        int x0 = int(au[r0 + q]), x1 = int(au[r1 + q]), x2 = int(au[r2 + q]), x3 = int(au[r3 + q]);
        uint wr = wb + q * NP;
        for (uint j = 0u; j < 12u; j++) {
            int wv = int(wu[wr + j]);
            acc0[j] += dotPacked4x8EXT(x0, wv);
            acc1[j] += dotPacked4x8EXT(x1, wv);
            acc2[j] += dotPacked4x8EXT(x2, wv);
            acc3[j] += dotPacked4x8EXT(x3, wv);
        }
    }
    for (uint j = 0u; j < 12u; j++) {
        uint n = cg * 12u + j;
        if (n >= N) continue;
        if (m0 < M)      au[ob + m0 * sOm + n] = uint(acc0[j]);
        if (m0 + 1u < M) au[ob + (m0 + 1u) * sOm + n] = uint(acc1[j]);
        if (m0 + 2u < M) au[ob + (m0 + 2u) * sOm + n] = uint(acc2[j]);
        if (m0 + 3u < M) au[ob + (m0 + 3u) * sOm + n] = uint(acc3[j]);
    }
}
